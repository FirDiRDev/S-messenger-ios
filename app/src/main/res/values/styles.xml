<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorOnSecondary">@color/colorOnPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="materialButtonStyle">@style/Widget.Stoyko.Button</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Stoyko.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Stoyko.Medium</item>
        <item name="android:windowAnimationStyle">@style/Stoyko.WindowAnimations</item>
        <item name="cardViewStyle">@style/Stoyko.Card</item>
        <item name="alertDialogTheme">@style/Stoyko.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Stoyko.Dialog</item>
        <item name="popupMenuStyle">@style/Stoyko.PopupMenu</item>
        <!-- Дата у ползунка быстрой прокрутки - небольшая, не жирная -->
        <item name="android:fastScrollStyle">@style/Stoyko.FastScroll</item>
        <item name="android:fastScrollPreviewBackgroundLeft">@drawable/bg_fastscroll_preview</item>
        <item name="android:fastScrollPreviewBackgroundRight">@drawable/bg_fastscroll_preview</item>
        <item name="android:fastScrollTextColor">@android:color/white</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#B3777777</item>
    </style>
    <!-- Полноэкранные окна (журнал ошибок и т. п.) -->
    <style name="AppTheme.FullDialog" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/colorBackground</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorSurface</item>
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="OptionGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <style name="SettingsHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/settingsAccent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableTint">@color/settingsAccent</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@color/dividerColor</item>
        <item name="android:alpha">0.6</item>
    </style>

    <style name="OptionRow">
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="OptionItemText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:padding">18dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <style name="DialogSlideAnimation" parent="Theme.AppCompat.Dialog">
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>

    <!-- Заставка при запуске: фирменный градиент с логотипом (без доп. библиотек) -->
    <style name="AppTheme.Launch">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Widget.Stoyko.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Stoyko.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">#80FFFFFF</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Shape.Stoyko.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Shape.Stoyko.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Stoyko.WindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Экран звонка -->
    <style name="CallButtonColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="CallButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_call_button</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="CallButtonLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Stoyko.Card" parent="CardView">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Stoyko.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:background">@color/colorSurface</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowAnimationStyle">@style/DialogPopAnimation</item>
        <!-- Кнопки диалогов - скруглённые, с анимацией нажатия; пункты списков - кнопки-карточки. -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Stoyko.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Stoyko.DialogButton.Tonal</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Stoyko.DialogButton.Tonal</item>
        <item name="alertDialogStyle">@style/Stoyko.AlertDialogStyle</item>
    </style>

    <style name="Stoyko.FastScroll" parent="@android:style/Widget.Material.FastScroll">
        <item name="android:textSize">13sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Stoyko.AlertDialogStyle" parent="AlertDialog.AppCompat">
        <item name="listItemLayout">@layout/dialog_list_item</item>
    </style>

    <style name="Widget.Stoyko.DialogButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Stoyko.DialogButton.Tonal">
        <item name="backgroundTint">@color/dialogButtonTonal</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- Диалоги «выпрыгивают» с пружиной и мягко исчезают -->
    <style name="DialogPopAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_pop_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_pop_out</item>
    </style>

    <style name="Stoyko.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <!-- Сезонные темы: весь мессенджер в цветах сезона (Персонализация → Сезонное оформление), диалоги - тоже. -->
    <style name="AppTheme.Autumn">
        <item name="colorPrimary">#EA580C</item>
        <item name="colorPrimaryDark">#9A3412</item>
        <item name="colorPrimaryVariant">#9A3412</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="colorSecondary">#F59E0B</item>
        <item name="colorSecondaryVariant">#B45309</item>
        <item name="android:statusBarColor">#9A3412</item>
        <item name="alertDialogTheme">@style/Stoyko.Dialog.Autumn</item>
        <item name="materialAlertDialogTheme">@style/Stoyko.Dialog.Autumn</item>
    </style>
    <style name="Stoyko.Dialog.Autumn">
        <item name="colorPrimary">#EA580C</item>
        <item name="colorAccent">#F59E0B</item>
        <item name="colorSecondary">#F59E0B</item>
    </style>
    <style name="AppTheme.Winter">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryDark">#1E3A8A</item>
        <item name="colorPrimaryVariant">#1E3A8A</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorSecondaryVariant">#0284C7</item>
        <item name="android:statusBarColor">#1E3A8A</item>
        <item name="alertDialogTheme">@style/Stoyko.Dialog.Winter</item>
        <item name="materialAlertDialogTheme">@style/Stoyko.Dialog.Winter</item>
    </style>
    <style name="Stoyko.Dialog.Winter">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorAccent">#38BDF8</item>
        <item name="colorSecondary">#38BDF8</item>
    </style>
    <style name="AppTheme.Spring">
        <item name="colorPrimary">#DB2777</item>
        <item name="colorPrimaryDark">#9D174D</item>
        <item name="colorPrimaryVariant">#9D174D</item>
        <item name="colorAccent">#F472B6</item>
        <item name="colorSecondary">#F472B6</item>
        <item name="colorSecondaryVariant">#BE185D</item>
        <item name="android:statusBarColor">#9D174D</item>
        <item name="alertDialogTheme">@style/Stoyko.Dialog.Spring</item>
        <item name="materialAlertDialogTheme">@style/Stoyko.Dialog.Spring</item>
    </style>
    <style name="Stoyko.Dialog.Spring">
        <item name="colorPrimary">#DB2777</item>
        <item name="colorAccent">#F472B6</item>
        <item name="colorSecondary">#F472B6</item>
    </style>
    <style name="AppTheme.Summer">
        <item name="colorPrimary">#0D9488</item>
        <item name="colorPrimaryDark">#115E59</item>
        <item name="colorPrimaryVariant">#115E59</item>
        <item name="colorAccent">#FBBF24</item>
        <item name="colorSecondary">#FBBF24</item>
        <item name="colorSecondaryVariant">#D97706</item>
        <item name="android:statusBarColor">#115E59</item>
        <item name="alertDialogTheme">@style/Stoyko.Dialog.Summer</item>
        <item name="materialAlertDialogTheme">@style/Stoyko.Dialog.Summer</item>
    </style>
    <style name="Stoyko.Dialog.Summer">
        <item name="colorPrimary">#0D9488</item>
        <item name="colorAccent">#FBBF24</item>
        <item name="colorSecondary">#FBBF24</item>
    </style>
</resources>
