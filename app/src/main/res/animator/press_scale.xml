<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка «сжимается» при нажатии и пружинит обратно с перелётом (Squish Button) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <set>
            <objectAnimator android:duration="90" android:interpolator="@android:anim/decelerate_interpolator" android:propertyName="scaleX" android:valueTo="0.92" android:valueType="floatType"/>
            <objectAnimator android:duration="90" android:interpolator="@android:anim/decelerate_interpolator" android:propertyName="scaleY" android:valueTo="0.92" android:valueType="floatType"/>
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="420" android:interpolator="@interpolator/spring_out" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType"/>
            <objectAnimator android:duration="420" android:interpolator="@interpolator/spring_out" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType"/>
        </set>
    </item>
</selector>
