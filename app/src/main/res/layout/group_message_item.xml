<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp">
    <!-- Строка сообщения: аватарка автора (с живым видео профиля, если есть) + пузырь -->
    <LinearLayout android:id="@+id/bubbleLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <FrameLayout android:id="@+id/senderAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom"
                android:layout_marginEnd="6dp"
                android:visibility="gone"/>
        <LinearLayout android:id="@+id/bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">
            <TextView android:id="@+id/sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            <FrameLayout android:id="@+id/imageBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                <ImageView android:id="@+id/image"
                        android:layout_width="220dp"
                        android:layout_height="160dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>
                <TextView android:id="@+id/videoPlay"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_video_play"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:visibility="gone"/>
                <com.stoyko.smessenger.ui.ProgressRingView android:id="@+id/imageRing"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:visibility="gone"/>
            </FrameLayout>
            <!-- «Кружок» -->
            <FrameLayout android:id="@+id/videoNoteBox"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                <com.stoyko.smessenger.media.VideoNoteView android:id="@+id/videoNote"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                <com.stoyko.smessenger.ui.ProgressRingView android:id="@+id/videoNoteRing"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:visibility="gone"/>
            </FrameLayout>
            <!-- Файл: круг загрузки, имя, «1,2 / 5 МБ · 300 КБ/с» -->
            <LinearLayout android:id="@+id/fileRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                <com.stoyko.smessenger.ui.ProgressRingView android:id="@+id/fileRing"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="10dp"
                        android:visibility="gone"/>
                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                    <TextView android:id="@+id/fileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxWidth="220dp"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"/>
                    <TextView android:id="@+id/fileInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/voiceLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                <ImageButton android:id="@+id/voicePlay"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_voice_play"
                        android:contentDescription="@string/voice_message"
                        android:src="@drawable/ic_play"
                        app:tint="@color/colorPrimary"/>
                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                    <com.stoyko.smessenger.ui.chat.WaveformView android:id="@+id/voiceWave"
                            android:layout_width="160dp"
                            android:layout_height="26dp"/>
                    <TextView android:id="@+id/voiceTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#E6FFFFFF"
                            android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:maxWidth="280dp"
                    android:textColor="@android:color/white"
                    android:textIsSelectable="false"
                    android:textSize="16sp"/>
            <TextView android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
    <!-- Комментарии к посту канала -->
    <TextView android:id="@+id/commentsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_system_line"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone"/>
</LinearLayout>
