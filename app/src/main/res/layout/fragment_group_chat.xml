<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@drawable/bg_brand_gradient"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:navigationIcon="@drawable/ic_back"
            app:popupTheme="@style/AppTheme.PopupOverlay"/>

    <!-- Панель активного группового звонка -->
    <LinearLayout android:id="@+id/callBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorAccent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone">
        <ImageView android:id="@+id/callPulse"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/circle"
                android:tint="@android:color/white"/>
        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/group_call_active"
                android:textColor="@android:color/white"/>
        <ImageButton android:id="@+id/callPeople"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/group_call_participants"
                android:src="@drawable/ic_group"
                android:tint="@android:color/white"/>
        <ImageButton android:id="@+id/callSpeaker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/speakerphone_toggle"
                android:src="@drawable/ic_speakerphone_off"
                android:tint="@android:color/white"/>
        <ImageButton android:id="@+id/callMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/group_call_mute"
                android:src="@drawable/ic_mic"
                android:tint="@android:color/white"/>
        <ImageButton android:id="@+id/callLeave"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/group_call_leave"
                android:src="@drawable/ic_call_end"
                android:tint="@android:color/white"/>
    </LinearLayout>

    <com.stoyko.smessenger.ui.SwipeReplyListView android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingVertical="8dp"
            android:stackFromBottom="true"
            android:transcriptMode="normal"/>

    <TextView android:id="@+id/scheduledBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp"
            android:visibility="gone"/>

    <TextView android:id="@+id/readonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/channel_readonly"
            android:visibility="gone"/>

    <LinearLayout android:id="@+id/replyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
        <View
                android:layout_width="3dp"
                android:layout_height="32dp"
                android:background="@color/colorPrimary"/>
        <TextView android:id="@+id/replyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"/>
        <ImageButton android:id="@+id/replyClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                android:src="@drawable/ic_close"
                android:tint="@color/textSecondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_input_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
        <ImageButton android:id="@+id/attach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/attach_file"
                android:src="@drawable/ic_attach_file"
                android:tint="@color/colorPrimary"/>
        <ImageButton android:id="@+id/stickers"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stickers"
                android:src="@drawable/ic_sticker"
                android:tint="@color/colorPrimary"/>
        <EditText android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/message"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="44dp"
                android:paddingHorizontal="6dp"/>
        <ImageButton android:id="@+id/send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/send"
                android:src="@drawable/ic_send"
                android:tint="@color/colorPrimary"
                android:visibility="gone"/>
        <ImageButton android:id="@+id/mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_message"
                android:src="@drawable/ic_mic"
                android:tint="@color/colorPrimary"/>
    </LinearLayout>
</LinearLayout>
