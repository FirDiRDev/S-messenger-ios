<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="com.stoyko.smessenger.ui.userprofile.UserProfileFragment">
    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/profile_collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">
            <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax">
                <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_contacts"/>
            </FrameLayout>
            <!-- Фото профиля: нажмите, чтобы сменить -->
            <FrameLayout
                    android:id="@+id/profileAvatarBox"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="64dp"
                    app:layout_collapseMode="parallax">
                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileAvatar"
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:elevation="6dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/profile_photo_description"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="#80FFFFFF"
                        app:strokeWidth="2dp"/>
                <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:elevation="7dp"
                        android:background="@drawable/bg_attach_icon"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:src="@drawable/ic_photo_camera"/>
            </FrameLayout>
            <androidx.appcompat.widget.Toolbar
                    android:id="@+id/profile_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="@drawable/ic_back"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>
            <androidx.appcompat.widget.Toolbar
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_gravity="bottom"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">
                    <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                        <ImageView
                                android:id="@+id/user_status"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_alignBottom="@+id/user_name"
                                android:layout_marginEnd="8dp"
                                android:layout_marginBottom="6dp"
                                android:contentDescription="@string/status_indicator"
                                android:src="@drawable/circle"/>
                        <TextView
                                android:id="@+id/user_name"
                                style="@style/TextAppearance.Widget.AppCompat.Toolbar.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@id/user_status"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Name goes here"/>
                    </RelativeLayout>
                    <TextView
                            android:id="@+id/user_status_message"
                            style="@style/TextAppearance.Widget.AppCompat.Toolbar.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            tools:text="Status message goes here"/>
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
            android:id="@+id/main_section"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:id="@+id/needsHacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp">
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="4dp"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="@string/profile_information"
                            android:textSize="16sp"/>
                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/dividerColor"/>
                    <RelativeLayout
                            android:id="@+id/profile_share_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                        <TextView
                                android:id="@+id/profile_share_id_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/tox_id"
                                android:textSize="16sp"
                                tools:ignore="RelativeOverlap" />

                        <!-- Reusing the read_qr ("QR") string here is a bit hacky, but I'll revisit it later if needed. -->
                        <ImageView
                                android:id="@+id/show_qr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@color/textWhiteColor"
                                android:contentDescription="@string/read_qr"
                                android:elevation="8dp"
                                android:src="@drawable/ic_qr_code"/>

                        <!-- Полный ID (76 символов) моноширинным шрифтом; касание - скопировать. -->
                        <TextView
                                android:id="@+id/user_tox_id"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/profile_share_id_title"
                                android:layout_marginEnd="48dp"
                                android:fontFamily="monospace"
                                android:textIsSelectable="true"
                                android:breakStrategy="simple"
                                android:textSize="13sp"
                                tools:targetApi="23"
                                tools:text="TOX ID GOES HERE"/>
                        <TextView
                                android:id="@+id/user_tox_id_copy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/user_tox_id"
                                android:layout_marginTop="8dp"
                                android:background="?attr/selectableItemBackground"
                                android:paddingVertical="6dp"
                                android:text="@string/tox_id_copy_full"
                                android:textColor="@color/colorAccent"
                                android:textStyle="bold"/>
                    </RelativeLayout>
                    <!-- Статус полностью и расширенный профиль (заполняется в коде). -->
                    <LinearLayout
                            android:id="@+id/profile_extra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <include android:id="@+id/profile_options" layout="@layout/profile_options"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
