<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingTop="12dp">
    <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:alpha="0.3"
            android:background="@color/textSecondary"/>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp"
            android:text="@string/attach_title"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold"/>
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
    <LinearLayout android:id="@+id/attachGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">
        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_icon"
                android:backgroundTint="#5B8DEF"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_image"/>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_gallery"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/attachCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">
        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_icon"
                android:backgroundTint="#E5484D"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_photo_camera"/>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_camera"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/attachVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">
        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_icon"
                android:backgroundTint="#F59E0B"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_photo_camera"/>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_video"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/attachFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">
        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_icon"
                android:backgroundTint="#22A06B"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_attach_file"/>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/attach_file"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"/>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
