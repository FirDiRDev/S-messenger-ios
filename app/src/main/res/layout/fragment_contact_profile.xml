<?xml version="1.0" encoding="utf-8"?>
<!-- Профиль собеседника: большая шапка с аватаром, быстрые действия,
     «Информация», код безопасности и общие медиа. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        tools:context=".ui.contactprofile.ContactProfileFragment">

    <androidx.core.widget.NestedScrollView android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">
        <LinearLayout android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

            <FrameLayout android:id="@+id/profileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brand_gradient">
                <LinearLayout android:id="@+id/profileHeaderInner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="72dp"
                        android:paddingBottom="22dp">
                    <FrameLayout android:layout_width="112dp"
                            android:layout_height="112dp">
                        <com.stoyko.smessenger.ui.AvatarImageView
                                android:id="@+id/avatarImageView"
                                android:layout_width="112dp"
                                android:layout_height="112dp"
                                android:elevation="6dp"
                                app:shapeAppearanceOverlay="@style/CircleImageView"
                                app:strokeColor="#66FFFFFF"
                                app:strokeWidth="3dp"/>
                        <View android:id="@+id/onlineDot"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_online_dot"
                                android:elevation="7dp"
                                android:visibility="gone"/>
                    </FrameLayout>
                    <TextView android:id="@+id/headerMainText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginHorizontal="24dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="@android:color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="Contact name"/>
                    <TextView android:id="@+id/headerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#D9FFFFFF"
                            android:textSize="14sp"
                            tools:text="в сети"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Быстрые действия -->
            <LinearLayout android:id="@+id/profileActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="12dp">
        <LinearLayout android:id="@+id/actionMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_action"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:stateListAnimator="@animator/press_scale">
            <ImageView android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/colorPrimary"/>
            <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="@string/write_message"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/actionCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_action"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:stateListAnimator="@animator/press_scale">
            <ImageView android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_call"
                    app:tint="@color/colorPrimary"/>
            <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="@string/audio_call"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/actionVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_action"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:stateListAnimator="@animator/press_scale">
            <ImageView android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_videocam"
                    app:tint="@color/colorPrimary"/>
            <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="@string/video_call"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/actionShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_action"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:stateListAnimator="@animator/press_scale">
            <ImageView android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_share"
                    app:tint="@color/colorPrimary"/>
            <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="@string/share"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"/>
        </LinearLayout>
        <!-- Подарок -->
        <LinearLayout android:id="@+id/actionGift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profile_action"
                android:elevation="2dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:stateListAnimator="@animator/press_scale">
            <TextView android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="🎁"
                    android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:text="@string/gift_action"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"/>
        </LinearLayout>
            </LinearLayout>
            <!-- Подарки, которые получил собеседник -->
            <LinearLayout android:id="@+id/giftsBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"/>

            <androidx.cardview.widget.CardView style="@style/OptionGroup">
                <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">
                    <TextView style="@style/SettingsHeading"
                            android:paddingTop="10dp"
                            android:text="@string/info"/>
                    <LinearLayout
                            android:id="@+id/contactStatusMessageRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">
                        <TextView android:id="@+id/contactStatusMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"/>
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_bio"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                            android:id="@+id/contactNameRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">
                        <TextView android:id="@+id/contactName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"/>
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_name_label"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                            android:id="@+id/contactConnectionStatusRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">
                        <TextView android:id="@+id/contactConnectionStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"/>
                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/profile_connection"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                            android:id="@+id/contactPublicKeyRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">
                        <TextView android:id="@+id/contactPublicKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/textPrimary"
                                android:fontFamily="monospace"
                                android:textSize="13sp"/>
                        <TextView android:id="@+id/contactIdLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/contact_full_id"
                                android:textColor="@color/textSecondary"
                                android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Код безопасности: сравните с собеседником - так вы убедитесь, что переписку никто не подменил -->
            <androidx.cardview.widget.CardView style="@style/OptionGroup">
                <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">
                    <TextView style="@style/SettingsHeading"
                            android:text="@string/security_code"
                            app:drawableStartCompat="@drawable/ic_lock"/>
                    <TextView android:id="@+id/securityCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="18dp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.05"
                            android:textColor="@color/textPrimary"
                            android:textIsSelectable="true"
                            android:textSize="16sp"/>
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="18dp"
                            android:layout_marginTop="6dp"
                            android:text="@string/security_code_hint"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp"/>
                    <TextView android:id="@+id/e2eCheckButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp"
                            android:text="@string/e2e_check_now"
                            android:textColor="@color/settingsAccent"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView style="@style/OptionGroup">
                <FrameLayout android:id="@+id/sharedMediaBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="120dp"
                        android:paddingBottom="8dp"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Панель сверху: прозрачная над шапкой, при прокрутке - «стекло» с именем. -->
    <com.stoyko.smessenger.ui.GlassFrameLayout android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar app:popupTheme="@style/AppTheme.PopupOverlay"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:titleTextColor="@android:color/white"/>
    </com.stoyko.smessenger.ui.GlassFrameLayout>
</FrameLayout>
