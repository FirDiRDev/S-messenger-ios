<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_brand_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
    <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_logo_circle"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/ic_lock"/>
    <TextView android:id="@+id/pinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pin_enter"
            android:textColor="@android:color/white"
            android:textSize="20sp"/>
    <TextView android:id="@+id/pinDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:letterSpacing="0.4"
            android:minHeight="36dp"
            android:textColor="@android:color/white"
            android:textSize="28sp"/>
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <TextView android:id="@+id/pin1"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <TextView android:id="@+id/pin2"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <TextView android:id="@+id/pin3"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
        </LinearLayout>
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <TextView android:id="@+id/pin4"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <TextView android:id="@+id/pin5"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <TextView android:id="@+id/pin6"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
        </LinearLayout>
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <TextView android:id="@+id/pin7"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <TextView android:id="@+id/pin8"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <TextView android:id="@+id/pin9"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="9"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
        </LinearLayout>
        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <ImageButton android:id="@+id/pinDel"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete"
                    android:src="@drawable/ic_backspace"/>
            <TextView android:id="@+id/pin0"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"/>
            <ImageButton android:id="@+id/pinOk"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pin_key"
                    android:backgroundTint="@color/colorAccent"
                    android:contentDescription="@android:string/ok"
                    android:src="@drawable/ic_check"/>
        </LinearLayout>
</LinearLayout>
