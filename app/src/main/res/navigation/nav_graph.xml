<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nav_graph"
        app:startDestination="@id/contactListFragment">
    <fragment android:id="@+id/profileFragment"
            android:name="com.stoyko.smessenger.ui.createprofile.CreateProfileFragment"
            android:label="ProfileFragment"
            tools:layout="@layout/fragment_profile"/>

    <fragment android:id="@+id/callFragment"
            android:name="com.stoyko.smessenger.ui.call.CallFragment"
            android:label="CallFragment"
            tools:layout="@layout/fragment_call"/>

    <fragment android:id="@+id/contactListFragment"
            android:name="com.stoyko.smessenger.ui.contactlist.ContactListFragment"
            android:label="ContactListFragment"
            tools:layout="@layout/fragment_contact_list">
        <action android:id="@+id/action_contactListFragment_to_chatFragment"
                app:destination="@id/chatFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>

        <action android:id="@+id/action_contactListFragment_to_contactProfileFragment"
                app:destination="@id/contactProfileFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>

        <action android:id="@+id/action_contactListFragment_to_friendRequestFragment"
                app:destination="@id/friendRequestFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>

        <action android:id="@+id/action_contactListFragment_to_addContactFragment"
                app:destination="@id/addContactFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>

        <action android:id="@+id/action_contactListFragment_to_profileFragment"
                app:destination="@id/profileFragment"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/fade_out"
                app:popExitAnim="@anim/fade_in"/>

        <action android:id="@+id/action_contactListFragment_to_settingsFragment"
                app:destination="@id/settingsFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>
        <action android:id="@+id/action_contactListFragment_to_groupListFragment"
                app:destination="@id/groupListFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>
        <action
                android:id="@+id/action_contactListFragment_to_userProfileFragment"
                app:destination="@id/userProfileFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>
    </fragment>

    <fragment android:id="@+id/friendRequestFragment"
        android:name="com.stoyko.smessenger.ui.friendrequest.FriendRequestFragment"
        android:label="FriendRequestFragment"
        tools:layout="@layout/fragment_friend_request"/>

    <fragment android:id="@+id/chatFragment"
            android:name="com.stoyko.smessenger.ui.chat.ChatFragment"
            android:label="ChatFragment"
            tools:layout="@layout/fragment_chat">
        <argument android:name="contactPublicKey" app:argType="string"/>

        <action android:id="@+id/action_chatFragment_to_contactProfileFragment"
                app:destination="@id/contactProfileFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>

        <action android:id="@+id/action_chatFragment_to_callFragment"
                app:destination="@id/callFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>
    </fragment>

    <fragment android:id="@+id/addContactFragment"
            android:name="com.stoyko.smessenger.ui.addcontact.AddContactFragment"
            android:label="add_contact_fragment"
            tools:layout="@layout/fragment_add_contact">
    </fragment>

    <fragment android:id="@+id/contactProfileFragment"
            android:name="com.stoyko.smessenger.ui.contactprofile.ContactProfileFragment"
            android:label="contact_profile_fragment"
            tools:layout="@layout/fragment_contact_profile">
        <action android:id="@+id/action_contactProfileFragment_to_chatFragment"
                app:destination="@id/chatFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>
        <action android:id="@+id/action_contactProfileFragment_to_callFragment"
                app:destination="@id/callFragment"
                app:enterAnim="@anim/fade_in"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/fade_out"/>
    </fragment>

    <fragment android:id="@+id/settingsFragment"
            android:name="com.stoyko.smessenger.ui.settings.SettingsFragment"
            android:label="SettingsFragment"
            tools:layout="@layout/fragment_settings"/>
    <fragment
            android:id="@+id/userProfileFragment"
            android:name="com.stoyko.smessenger.ui.userprofile.UserProfileFragment"
            android:label="fragment_user_profile"
            tools:layout="@layout/fragment_user_profile"/>

    <fragment android:id="@+id/groupListFragment"
            android:name="com.stoyko.smessenger.ui.groups.GroupListFragment"
            android:label="GroupListFragment"
            tools:layout="@layout/fragment_group_list">
        <action android:id="@+id/action_groupListFragment_to_groupChatFragment"
                app:destination="@id/groupChatFragment"
                app:enterAnim="@anim/nav_enter"
                app:exitAnim="@anim/nav_exit"
                app:popEnterAnim="@anim/nav_pop_enter"
                app:popExitAnim="@anim/nav_pop_exit"/>
    </fragment>

    <fragment android:id="@+id/groupChatFragment"
            android:name="com.stoyko.smessenger.ui.groups.GroupChatFragment"
            android:label="GroupChatFragment"
            tools:layout="@layout/fragment_group_chat">
        <argument android:name="groupChatId" app:argType="string"/>
    </fragment>
</navigation>
