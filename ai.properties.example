# Встроенный помощник S-AI (OpenAI-совместимый API).
# По умолчанию (без этого файла) S-AI работает через шлюз Vireonix:
#   без регистрации и ключа, модель "auto" (сам выбирает модель под задачу),
#   лимит на один IP: 20 млн входных и 200 тыс. выходных токенов в час.
# Чтобы использовать другой сервис для всех пользователей, скопируйте этот файл
# в ai.properties (рядом с build_apk.bat), поменяйте значения и соберите APK.
baseUrl=https://vireonix.ai/v1
apiKey=none
model=auto
